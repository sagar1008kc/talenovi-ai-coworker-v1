# Copy to .env and fill in. NEVER put real keys in this example file.
# Claude Pro / Claude Code login does not cover Anthropic API usage.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# fal.ai: the full key is "<key_id>:<key_secret>" (both parts, joined by a colon).
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-2/flash
FAL_VIDEO_MODEL=alibaba/wan-3.0/image-to-video

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Voice roster: one variable per ROLE, named ELEVENLABS_<ROLE>_VOICE_ID ---
# Use voices you have commercial rights to and that appear under "My Voices" in ElevenLabs.
# Run `.venv/bin/python main.py voices` to check every role (name, gender, age, accent).
# Casting assigns each character the best-fitting role; add any roles you like.
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_SERIOUS_WOMAN_VOICE_ID=
ELEVENLABS_WARM_WOMAN_VOICE_ID=
ELEVENLABS_SERIOUS_MAN_VOICE_ID=
ELEVENLABS_COMEDIAN_MAN_VOICE_ID=
ELEVENLABS_CHILD_GIRL_VOICE_ID=
ELEVENLABS_CHILD_BOY_VOICE_ID=
ELEVENLABS_ELDERLY_WOMAN_VOICE_ID=
ELEVENLABS_ELDERLY_MAN_VOICE_ID=
# The series narrator reads this alias:
ELEVENLABS_VOICE_ID=${ELEVENLABS_NARRATOR_VOICE_ID}

# Optional secondary video provider for the factual autopilot only:
#RUNWAYML_API_SECRET=
